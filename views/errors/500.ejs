<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Server Error</title>
  <link rel="stylesheet" href="/css/style.css">
</head>
<body class="auth-body">
  <div class="auth-card">
    <div class="auth-header" style="background: var(--danger);">
      <div class="auth-logo">500</div>
      <h2>Server Error</h2>
      <p>An unexpected error occurred</p>
    </div>
    <div class="auth-body-inner text-center">
      <p style="margin-bottom: 20px; color: var(--gray-600);">Please try again later or contact the system administrator.</p>
      <a href="/" class="btn btn-outline-secondary">Go to Home</a>
    </div>
  </div>
</body>
</html>