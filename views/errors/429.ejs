<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <meta name="robots" content="noindex, nofollow">
  <title>Too Many Requests | Mahayag MSWD</title>
  <style>
    :root { --blue:#0B5ED7; --blue-dark:#073B7A; --blue-deep:#062E60; --navy:#12355B; --border:#D8E3F0; --light:#EAF3FF; }
    * { box-sizing:border-box; }
    html, body { height:100%; }
    body {
      margin:0; display:flex; align-items:center; justify-content:center; padding:24px;
      font-family:-apple-system,BlinkMacSystemFont,"Segoe UI",Roboto,Arial,sans-serif;
      background:linear-gradient(160deg,var(--blue-deep) 0%,var(--blue-dark) 40%,var(--blue) 100%);
      color:var(--navy); line-height:1.55;
    }
    .ed-card {
      width:min(100%,460px); background:#fff; border:1px solid var(--border);
      border-radius:22px; box-shadow:0 18px 50px rgba(6,46,96,.35); overflow:hidden;
      text-align:center; position:relative;
    }
    .ed-card::before { content:""; position:absolute; top:0; left:0; right:0; height:6px; background:linear-gradient(90deg,#9a6700,#f2b23d); }
    .ed-fill { padding:40px 36px 30px; }
    .ed-code { font-size:64px; font-weight:800; letter-spacing:2px; color:#9a6700; line-height:1; }
    .ed-title { font-size:22px; font-weight:800; color:var(--navy); margin:10px 0 8px; }
    .ed-msg { font-size:14px; color:#66748c; margin:0 0 24px; }
    .ed-ico { width:44px; height:44px; margin:0 auto 18px; color:#9a6700; border-radius:50%; background:#fff8e6; display:flex; align-items:center; justify-content:center; }
    .ed-actions { display:flex; gap:12px; justify-content:center; border-top:1px solid var(--border); padding:18px; background:#fbfdff; }
    .btn {
      display:inline-flex; align-items:center; justify-content:center; gap:8px;
      padding:11px 18px; border-radius:12px; font-size:14px; font-weight:700; cursor:pointer;
      text-decoration:none; transition:transform .14s ease, box-shadow .16s ease;
    }
    .btn-primary { background:linear-gradient(180deg,#0A4FC0,var(--blue) 55%,var(--blue-dark)); color:#fff; box-shadow:0 8px 18px rgba(11,94,215,.28); }
    .btn-primary:hover { transform:translateY(-1px); }
  </style>
</head>
<body>
  <main class="ed-card">
    <div class="ed-fill">
      <div class="ed-ico">
        <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><circle cx="12" cy="12" r="9"/><polyline points="12 6 12 12 16 14"/></svg>
      </div>
      <div class="ed-code">429</div>
      <h1 class="ed-title">Too Many Requests</h1>
      <p class="ed-msg">Too many attempts. Please wait a few minutes before trying again.</p>
    </div>
    <div class="ed-actions">
      <a class="btn btn-primary" href="/login">Back to Login</a>
    </div>
  </main>
</body>
</html>