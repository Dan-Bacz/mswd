<% var isEdit = typeof b !== 'undefined' && b; var pageTitle = isEdit ? 'Edit Beneficiary' : 'New Beneficiary'; var title = pageTitle; %>

<div class="page-head">
  <div>
    <h1 class="page-title"><%= pageTitle %></h1>
    <p class="page-sub"><%= isEdit ? 'Update the beneficiary details below.' : 'Register a new beneficiary for services.' %></p>
  </div>
  <a class="btn btn-outline" href="/admin/beneficiaries">&laquo; Back to list</a>
</div>

<div class="card">
  <div class="card-body">
    <form method="POST" action="<%= isEdit ? '/admin/beneficiaries/' + b.id : '/admin/beneficiaries' %>">
      <input type="hidden" name="_csrf" value="<%= csrfToken %>">
      <div class="form-grid">
        <div class="form-group">
          <label for="last_name">Last Name <span class="required-star">*</span></label>
          <input type="text" id="last_name" name="last_name" class="form-control" required value="<%= isEdit ? b.last_name : '' %>">
        </div>
        <div class="form-group">
          <label for="first_name">First Name <span class="required-star">*</span></label>
          <input type="text" id="first_name" name="first_name" class="form-control" required value="<%= isEdit ? b.first_name : '' %>">
        </div>
        <div class="form-group">
          <label for="middle_name">Middle Name</label>
          <input type="text" id="middle_name" name="middle_name" class="form-control" value="<%= isEdit && b.middle_name ? b.middle_name : '' %>">
        </div>
        <div class="form-group">
          <label for="suffix">Suffix</label>
          <input type="text" id="suffix" name="suffix" class="form-control" value="<%= isEdit && b.suffix ? b.suffix : '' %>" placeholder="Jr., Sr., III">
        </div>
        <div class="form-group">
          <label for="sector_id">Sector <span class="required-star">*</span></label>
          <select id="sector_id" name="sector_id" class="form-control" required>
            <option value="">-- Select sector --</option>
            <% sectors.forEach(function(s) { %>
              <option value="<%= s.id %>" <%= isEdit && b.sector_id === s.id ? 'selected' : '' %>><%= s.name %></option>
            <% }) %>
          </select>
        </div>
        <div class="form-group">
          <label for="date_of_birth">Date of Birth</label>
          <input type="date" id="date_of_birth" name="date_of_birth" class="form-control" value="<%= isEdit ? h.formatDate(b.date_of_birth) : '' %>">
        </div>
        <div class="form-group">
          <label for="sex">Sex</label>
          <select id="sex" name="sex" class="form-control">
            <option value="">-- Select --</option>
            <% ['Male','Female','Other'].forEach(function(x) { %>
              <option value="<%= x %>" <%= isEdit && b.sex === x ? 'selected' : '' %>><%= x %></option>
            <% }) %>
          </select>
        </div>
        <div class="form-group">
          <label for="civil_status">Civil Status</label>
          <select id="civil_status" name="civil_status" class="form-control">
            <option value="">-- Select --</option>
            <% ['Single','Married','Widowed','Separated','Divorced'].forEach(function(x) { %>
              <option value="<%= x %>" <%= isEdit && b.civil_status === x ? 'selected' : '' %>><%= x %></option>
            <% }) %>
          </select>
        </div>
        <div class="form-group full">
          <label for="address">Address</label>
          <input type="text" id="address" name="address" class="form-control" value="<%= isEdit && b.address ? b.address : '' %>" placeholder="House no., Street, Purok / Sitio">
        </div>
        <div class="form-group">
          <label for="barangay">Barangay</label>
          <input type="text" id="barangay" name="barangay" class="form-control" value="<%= isEdit && b.barangay ? b.barangay : '' %>">
        </div>
        <div class="form-group">
          <label for="contact_number">Contact Number</label>
          <input type="text" id="contact_number" name="contact_number" class="form-control" value="<%= isEdit && b.contact_number ? b.contact_number : '' %>" placeholder="09XXXXXXXXX">
        </div>
        <div class="form-group">
          <label for="email">Email</label>
          <input type="email" id="email" name="email" class="form-control" value="<%= isEdit && b.email ? b.email : '' %>">
        </div>
        <div class="form-group">
          <label for="status">Status</label>
          <select id="status" name="status" class="form-control">
            <% ['Active','Inactive','Archived'].forEach(function(x) { %>
              <option value="<%= x %>" <%= isEdit && b.status === x ? 'selected' : '' %>><%= x %></option>
            <% }) %>
          </select>
        </div>
      </div>
      <div class="form-actions">
        <button type="submit" class="btn btn-primary"><%= isEdit ? 'Save Changes' : 'Register Beneficiary' %></button>
        <a class="btn btn-outline" href="/admin/beneficiaries">Cancel</a>
      </div>
    </form>
  </div>
</div>