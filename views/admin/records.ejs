<% var pageTitle = cfg.title; var title = pageTitle; %>
<% var listCols = cfg.listCols; %>

<div class="page-head">
  <div>
    <h1 class="page-title"><%= cfg.title %></h1>
    <p class="page-sub">Manage <%= cfg.item.toLowerCase() %> records for the <%= cfg.title.replace(' Records', '').replace(' Cases', '') %> sector.</p>
  </div>
  <a class="btn btn-primary" href="/admin/records/<%= slug %>/new">
    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round"><line x1="12" y1="5" x2="12" y2="19"/><line x1="5" y1="12" x2="19" y2="12"/></svg>
    New <%= cfg.item %>
  </a>
</div>

<div class="card">
  <div class="toolbar">
    <form method="GET" action="/admin/records/<%= slug %>">
      <input type="text" name="search" value="<%= search %>" class="form-control compact" style="min-width:220px" placeholder="Search reference or name...">
      <select name="status" class="form-control compact">
        <option value="all">All statuses</option>
        <% cfg.statuses.forEach(function(st) { %>
          <option value="<%= st %>" <%= status === st ? 'selected' : '' %>><%= st %></option>
        <% }) %>
      </select>
      <button type="submit" class="btn btn-outline">Filter</button>
    </form>
  </div>

  <div class="card-body flush">
    <% if (rows.length === 0) { %>
      <div class="empty-state">
        <p>No records found.</p>
        <a class="btn btn-primary btn-sm" href="/admin/records/<%= slug %>/new">Add <%= cfg.item %></a>
      </div>
    <% } else { %>
      <div class="table-wrap">
        <table class="table">
          <thead>
            <tr>
              <th>Beneficiary</th>
              <% listCols.forEach(function(col) { %>
                <% var label = cfg.fields.filter(function(f){ return f.col === col; })[0]; %>
                <th><%= label ? label.label : col %></th>
              <% }) %>
              <th></th>
            </tr>
          </thead>
          <tbody>
            <% rows.forEach(function(r) { %>
              <tr>
                <td class="row-primary"><%= h.fullName(r) %></td>
                <% listCols.forEach(function(col) { %>
                  <% if (col === cfg.statusColumn) { %>
                    <td><span class="badge <%= h.badgeClass(r[col]) %>"><%= r[col] || '—' %></span></td>
                  <% } else if (col === cfg.numberColumn) { %>
                    <td><a href="/admin/records/<%= slug %>/<%= r.id %>"><%= r[col] || '—' %></a></td>
                  <% } else if (col === 'date_opened' || col === 'valid_until' || col === 'registration_date' || col === 'date_closed') { %>
                    <td class="row-muted"><%= h.formatDisplayDate(r[col]) %></td>
                  <% } else { %>
                    <td><%= r[col] || '—' %></td>
                  <% } %>
                <% }) %>
                <td>
                  <div class="row-actions">
                    <a class="btn btn-ghost btn-sm" href="/admin/records/<%= slug %>/<%= r.id %>">View</a>
                    <a class="btn btn-ghost btn-sm" href="/admin/records/<%= slug %>/<%= r.id %>/edit">Edit</a>
                  </div>
                </td>
              </tr>
            <% }) %>
          </tbody>
        </table>
      </div>
    <% } %>
  </div>

  <div class="pagination">
    <% if (pg.totalPages > 1) { %>
      <% var base = '/admin/records/' + slug + '?page='; %>
      <% if (pg.hasPrev) { %><a class="page-link" href="<%= base + (pg.page - 1) %>">&laquo;</a><% } %>
      <% for (var p = Math.max(1, pg.page - 2); p <= Math.min(pg.totalPages, pg.page + 2); p++) { %>
        <a class="page-link <%= p === pg.page ? 'current' : '' %>" href="<%= base + p %>"><%= p %></a>
      <% } %>
      <% if (pg.hasNext) { %><a class="page-link" href="<%= base + (pg.page + 1) %>">&raquo;</a><% } %>
      <span class="pg-info"><%= pg.total %> record(s)</span>
    <% } else { %>
      <span class="pg-info"><%= pg.total %> record(s)</span>
    <% } %>
  </div>
</div>