<div class="page-title-row">
  <div>
    <h2><%= ben.first_name %> <%= ben.middle_name ? ben.middle_name.charAt(0) + '.' : '' %> <%= ben.last_name %> <%= ben.suffix || '' %></h2>
    <div class="subtitle"><strong><%= ben.beneficiary_number %></strong> &middot; <%= ben.sector_name %> Sector</div>
  </div>
  <div class="page-actions d-flex gap-8">
    <a href="/admin/beneficiaries/<%= ben.id %>/edit" class="btn btn-outline-primary">Edit</a>
    <form method="POST" action="/admin/beneficiaries/<%= ben.id %>/status" onsubmit="return confirm('Update beneficiary status?')">
      <input type="hidden" name="_csrf" value="<%= csrfToken() %>">
      <select name="status" class="form-control" onchange="this.form.submit()">
        <option value="Active" <%= ben.status === 'Active' ? 'selected' : '' %>>Active</option>
        <option value="Inactive" <%= ben.status === 'Inactive' ? 'selected' : '' %>>Inactive</option>
        <option value="Archived" <%= ben.status === 'Archived' ? 'selected' : '' %>>Archived</option>
      </select>
    </form>
  </div>
</div>

<div class="card">
  <div class="card-body">
    <div class="detail-grid mb-24">
      <div class="detail-item"><div class="d-label">Full Name</div><div class="d-value"><%= ben.first_name %> <%= ben.middle_name || '' %> <%= ben.last_name %> <%= ben.suffix || '' %></div></div>
      <div class="detail-item"><div class="d-label">Sector</div><div class="d-value"><span class="badge badge-green"><%= ben.sector_name %></span></div></div>
      <div class="detail-item"><div class="d-label">Status</div><div class="d-value">
        <% if (ben.status === 'Active') { %><span class="badge badge-green">Active</span><% } %>
        <% if (ben.status === 'Inactive') { %><span class="badge badge-gray">Inactive</span><% } %>
        <% if (ben.status === 'Archived') { %><span class="badge badge-red">Archived</span><% } %>
      </div></div>
      <div class="detail-item"><div class="d-label">Date of Birth</div><div class="d-value"><%= ben.date_of_birth ? new Date(ben.date_of_birth).toDateString() : '-' %></div></div>
      <div class="detail-item"><div class="d-label">Sex</div><div class="d-value"><%= ben.sex || '-' %></div></div>
      <div class="detail-item"><div class="d-label">Civil Status</div><div class="d-value"><%= ben.civil_status || '-' %></div></div>
    </div>
    <h3 class="mb-8">Contact & Address</h3>
    <div class="detail-grid">
      <div class="detail-item"><div class="d-label">Address</div><div class="d-value"><%= ben.address || '-' %></div></div>
      <div class="detail-item"><div class="d-label">Barangay</div><div class="d-value"><%= ben.barangay || '-' %></div></div>
      <div class="detail-item"><div class="d-label">Contact Number</div><div class="d-value"><%= ben.contact_number || '-' %></div></div>
      <div class="detail-item"><div class="d-label">Email</div><div class="d-value"><%= ben.email || '-' %></div></div>
      <div class="detail-item"><div class="d-label">Registration Date</div><div class="d-value"><%= new Date(ben.registration_date).toDateString() %></div></div>
      <div class="detail-item"><div class="d-label">Registered By</div><div class="d-value"><%= ben.reg_by_first ? ben.reg_by_first + ' ' + ben.reg_by_last : '-' %></div></div>
    </div>
  </div>
</div>

<div class="tabs" id="detail-tabs">
  <button class="tab-btn active" data-tab="tab-sector">Sector Record</button>
  <button class="tab-btn" data-tab="tab-services">Services (<%= services.length %>)</button>
  <button class="tab-btn" data-tab="tab-notes">Case Notes (<%= notes.length %>)</button>
  <button class="tab-btn" data-tab="tab-followups">Follow-ups (<%= followups.length %>)</button>
  <button class="tab-btn" data-tab="tab-documents">Documents (<%= documents.length %>)</button>
</div>

<div class="tab-pane active" id="tab-sector">
  <div class="card">
    <div class="card-header"><h3>Sector-Specific Record</h3></div>
    <div class="card-body">
      <% if (ben.sector_slug === 'juvenile') { %>
        <% if (juvenile.length) { %>
          <div class="detail-grid">
            <div class="detail-item"><div class="d-label">Case Number</div><div class="d-value"><%= juvenile[0].case_number %></div></div>
            <div class="detail-item"><div class="d-label">Case Status</div><div class="d-value"><span class="badge badge-blue"><%= juvenile[0].case_status %></span></div></div>
            <div class="detail-item"><div class="d-label">Case Type</div><div class="d-value"><%= juvenile[0].case_type || '-' %></div></div>
            <div class="detail-item"><div class="d-label">Risk Level</div><div class="d-value"><%= juvenile[0].risk_level || '-' %></div></div>
            <div class="detail-item"><div class="d-label">Guardian</div><div class="d-value"><%= juvenile[0].guardian_name || '-' %></div></div>
            <div class="detail-item"><div class="d-label">Date Opened</div><div class="d-value"><%= new Date(juvenile[0].date_opened).toDateString() %></div></div>
          </div>
          <div class="form-actions">
            <a href="/admin/juvenile/cases/<%= juvenile[0].id %>" class="btn btn-primary btn-sm">View Case Detail</a>
          </div>
        <% } else { %>
          <div class="empty-state"><h4>No juvenile case record yet</h4><a href="/admin/juvenile/cases/new?beneficiary=<%= ben.id %>&sector=<%= ben.sector_id %>" class="btn btn-outline-primary btn-sm mt-8">Open a Case</a></div>
        <% } %>
      <% } %>

      <% if (ben.sector_slug === 'solo-parent') { %>
        <% if (soloParent.length) { %>
          <div class="detail-grid">
            <div class="detail-item"><div class="d-label">Record Number</div><div class="d-value"><%= soloParent[0].record_number %></div></div>
            <div class="detail-item"><div class="d-label">No. of Children</div><div class="d-value"><%= soloParent[0].number_of_children %></div></div>
            <div class="detail-item"><div class="d-label">Employment</div><div class="d-value"><%= soloParent[0].employment_status || '-' %></div></div>
            <div class="detail-item"><div class="d-label">Monthly Income</div><div class="d-value"><%= soloParent[0].monthly_income ? 'P' + Number(soloParent[0].monthly_income).toLocaleString() : '-' %></div></div>
            <div class="detail-item"><div class="d-label">PCSO No.</div><div class="d-value"><%= soloParent[0].pcso_number || '-' %></div></div>
            <div class="detail-item"><div class="d-label">Valid Until</div><div class="d-value"><%= soloParent[0].valid_until ? new Date(soloParent[0].valid_until).toDateString() : '-' %></div></div>
          </div>
          <div class="form-actions">
            <a href="/admin/solo-parent/records/<%= soloParent[0].id %>" class="btn btn-primary btn-sm">View Record</a>
          </div>
        <% } else { %>
          <div class="empty-state"><h4>No solo parent record yet</h4><a href="/admin/solo-parent/records/new?beneficiary=<%= ben.id %>" class="btn btn-outline-primary btn-sm mt-8">Create Record</a></div>
        <% } %>
      <% } %>

      <% if (ben.sector_slug === 'senior-citizens') { %>
        <% if (senior.length) { %>
          <div class="detail-grid">
            <div class="detail-item"><div class="d-label">Record Number</div><div class="d-value"><%= senior[0].record_number %></div></div>
            <div class="detail-item"><div class="d-label">OSCA Number</div><div class="d-value"><%= senior[0].osca_number || '-' %></div></div>
            <div class="detail-item"><div class="d-label">Pension Status</div><div class="d-value"><%= senior[0].pension_status %></div></div>
            <div class="detail-item"><div class="d-label">Living Situation</div><div class="d-value"><%= senior[0].living_situation %></div></div>
          </div>
          <div class="form-actions">
            <a href="/admin/senior-citizens/records/<%= senior[0].id %>" class="btn btn-primary btn-sm">View Record</a>
          </div>
        <% } else { %>
          <div class="empty-state"><h4>No senior citizen record yet</h4><a href="/admin/senior-citizens/records/new?beneficiary=<%= ben.id %>" class="btn btn-outline-primary btn-sm mt-8">Create Record</a></div>
        <% } %>
      <% } %>

      <% if (ben.sector_slug === 'pwd') { %>
        <% if (pwd.length) { %>
          <div class="detail-grid">
            <div class="detail-item"><div class="d-label">Record Number</div><div class="d-value"><%= pwd[0].record_number %></div></div>
            <div class="detail-item"><div class="d-label">PWD Number</div><div class="d-value"><%= pwd[0].pwd_number || '-' %></div></div>
            <div class="detail-item"><div class="d-label">Disability Type</div><div class="d-value"><%= pwd[0].disability_type %></div></div>
            <div class="detail-item"><div class="d-label">Disability Level</div><div class="d-value"><%= pwd[0].disability_level %></div></div>
            <div class="detail-item"><div class="d-label">Assistive Device</div><div class="d-value"><%= pwd[0].assistive_device || '-' %></div></div>
          </div>
          <div class="form-actions">
            <a href="/admin/pwd/records/<%= pwd[0].id %>" class="btn btn-primary btn-sm">View Record</a>
          </div>
        <% } else { %>
          <div class="empty-state"><h4>No PWD record yet</h4><a href="/admin/pwd/records/new?beneficiary=<%= ben.id %>" class="btn btn-outline-primary btn-sm mt-8">Create Record</a></div>
        <% } %>
      <% } %>
    </div>
  </div>
</div>

<div class="tab-pane" id="tab-services">
  <div class="card">
    <div class="card-header">
      <h3>Services Provided</h3>
      <a href="/admin/beneficiaries/<%= ben.id %>/services/new" class="btn btn-sm btn-outline-primary">+ Add Service</a>
    </div>
    <div class="table-responsive">
      <table class="data-table">
        <thead><tr><th>Service</th><th>Date</th><th>Status</th><th>Provided By</th><th></th></tr></thead>
        <tbody>
          <% services.forEach(function(s) { %>
            <tr>
              <td><strong><%= s.service_name %></strong><% if (s.details) { %><div class="small text-muted"><%= s.details %></div><% } %></td>
              <td class="small"><%= s.date_provided %></td>
              <td>
                <% if (s.status === 'Completed') { %><span class="badge badge-green">Completed</span><% } %>
                <% if (s.status === 'Pending') { %><span class="badge badge-gold">Pending</span><% } %>
                <% if (s.status === 'Ongoing') { %><span class="badge badge-blue">Ongoing</span><% } %>
                <% if (s.status === 'Cancelled') { %><span class="badge badge-red">Cancelled</span><% } %>
              </td>
              <td class="small"><%= s.first_name ? s.first_name + ' ' + s.last_name : '-' %></td>
              <td>
                <form method="POST" action="/api/services/delete" onsubmit="return confirm('Delete this service record?')">
                  <input type="hidden" name="_csrf" value="<%= csrfToken() %>">
                  <input type="hidden" name="id" value="<%= s.id %>">
                  <input type="hidden" name="redirect" value="/admin/beneficiaries/<%= ben.id %>">
                  <button type="submit" class="btn btn-sm btn-outline-danger">Delete</button>
                </form>
              </td>
            </tr>
          <% }) %>
          <% if (!services.length) { %><tr><td colspan="5"><div class="empty-state"><h4>No services provided</h4></div></td></tr><% } %>
        </tbody>
      </table>
    </div>
  </div>
</div>

<div class="tab-pane" id="tab-notes">
  <div class="card">
    <div class="card-header"><h3>Case Notes</h3></div>
    <div class="card-body">
      <form method="POST" action="/api/notes/add">
        <input type="hidden" name="_csrf" value="<%= csrfToken() %>">
        <input type="hidden" name="beneficiary_id" value="<%= ben.id %>">
        <input type="hidden" name="redirect" value="/admin/beneficiaries/<%= ben.id %>">
        <div class="form-group">
          <textarea name="note" class="form-control" placeholder="Write a case note..." required></textarea>
        </div>
        <button type="submit" class="btn btn-primary btn-sm">Add Note</button>
      </form>
      <div class="mt-16">
        <% notes.forEach(function(n) { %>
          <div class="card" style="margin-bottom: 10px; box-shadow: none;">
            <div class="card-body" style="padding: 12px 16px;">
              <%= n.note %>
              <div class="small text-muted mt-8">By <%= n.first_name ? n.first_name + ' ' + n.last_name : 'Unknown' %> on <%= new Date(n.created_at).toLocaleString() %></div>
            </div>
          </div>
        <% }) %>
        <% if (!notes.length) { %><div class="empty-state"><h4>No case notes</h4></div><% } %>
      </div>
    </div>
  </div>
</div>

<div class="tab-pane" id="tab-followups">
  <div class="card">
    <div class="card-header"><h3>Case Follow-ups</h3></div>
    <div class="table-responsive">
      <table class="data-table">
        <thead><tr><th>Type</th><th>Scheduled</th><th>Completed</th><th>Status</th><th></th></tr></thead>
        <tbody>
          <% followups.forEach(function(f) { %>
            <tr>
              <td><%= f.followup_type %></td>
              <td class="small"><%= f.scheduled_date || '-' %></td>
              <td class="small"><%= f.completed_date || '-' %></td>
              <td>
                <% if (f.status === 'Completed') { %><span class="badge badge-green">Completed</span><% } %>
                <% if (f.status === 'Scheduled') { %><span class="badge badge-gold">Scheduled</span><% } %>
                <% if (f.status === 'Missed') { %><span class="badge badge-red">Missed</span><% } %>
              </td>
              <td>
                <form method="POST" action="/api/followups/complete" onsubmit="return confirm('Mark as completed?')">
                  <input type="hidden" name="_csrf" value="<%= csrfToken() %>">
                  <input type="hidden" name="id" value="<%= f.id %>">
                  <input type="hidden" name="redirect" value="/admin/beneficiaries/<%= ben.id %>">
                  <button type="submit" class="btn btn-sm btn-success">Mark Done</button>
                </form>
              </td>
            </tr>
          <% }) %>
          <% if (!followups.length) { %><tr><td colspan="5"><div class="empty-state"><h4>No follow-ups scheduled</h4></div></td></tr><% } %>
        </tbody>
      </table>
    </div>
  </div>
</div>

<div class="tab-pane" id="tab-documents">
  <div class="card">
    <div class="card-header"><h3>Documents</h3></div>
    <div class="card-body">
      <% if (documents.length) { %>
        <div class="table-responsive">
          <table class="data-table">
            <thead><tr><th>Document</th><th>Type</th><th>Uploaded</th><th></th></tr></thead>
            <tbody>
              <% documents.forEach(function(d) { %>
                <tr>
                  <td><strong><%= d.document_name %></strong></td>
                  <td class="small"><%= d.document_type || '-' %></td>
                  <td class="small"><%= new Date(d.created_at).toLocaleDateString() %></td>
                  <td><a href="<%= d.file_path %>" target="_blank" class="btn btn-sm btn-outline-secondary">View</a></td>
                </tr>
              <% }) %>
            </tbody>
          </table>
        </div>
      <% } else { %>
        <div class="empty-state"><h4>No documents uploaded</h4></div>
      <% } %>
    </div>
  </div>
</div>