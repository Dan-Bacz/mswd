<% var pageTitle = 'Beneficiary Profile'; var title = pageTitle; %>

<div class="page-head">
  <div>
    <h1 class="page-title"><%= h.fullName(b) %></h1>
    <p class="page-sub">
      Beneficiary No. <strong><%= b.beneficiary_number %></strong>
      &middot; <span class="badge <%= h.badgeClass(b.status) %>"><%= b.status %></span>
      &middot; <span class="badge badge-blue"><%= b.sector_name %></span>
    </p>
  </div>
  <div class="row-actions">
    <a class="btn btn-outline" href="/admin/beneficiaries/<%= b.id %>/edit">Edit</a>
    <form method="POST" action="/admin/beneficiaries/<%= b.id %>/status" data-confirm="Archive this beneficiary?">
      <input type="hidden" name="_csrf" value="<%= csrfToken %>">
      <input type="hidden" name="status" value="Archived">
      <button type="submit" class="btn btn-danger">Archive</button>
    </form>
  </div>
</div>

<div class="grid-2">
  <div class="card">
    <div class="card-head"><h3 class="card-title">Details</h3></div>
    <div class="card-body">
      <div class="detail-list">
        <div class="detail-item"><span class="k">Full Name</span><span class="v"><%= h.fullName(b) %></span></div>
        <div class="detail-item"><span class="k">Date of Birth</span><span class="v"><%= h.formatDisplayDate(b.date_of_birth) %> <% if (b.date_of_birth) { %>(<%= h.calculateAge(b.date_of_birth) %> yrs)<% } %></span></div>
        <div class="detail-item"><span class="k">Sex</span><span class="v"><%= b.sex || '—' %></span></div>
        <div class="detail-item"><span class="k">Civil Status</span><span class="v"><%= b.civil_status || '—' %></span></div>
        <div class="detail-item"><span class="k">Contact</span><span class="v"><%= b.contact_number || '—' %></span></div>
        <div class="detail-item"><span class="k">Email</span><span class="v"><%= b.email || '—' %></span></div>
        <div class="detail-item full"><span class="k">Address</span><span class="v"><%= b.address ? b.address + (b.barangay ? ', ' + b.barangay : '') : (b.barangay || '—') %></span></div>
        <div class="detail-item"><span class="k">Registered</span><span class="v"><%= h.formatDisplayDate(b.registration_date || b.created_at) %></span></div>
        <div class="detail-item"><span class="k">Registered By</span><span class="v"><%= b.reg_first ? b.reg_first + ' ' + b.reg_last : '—' %></span></div>
      </div>
    </div>
  </div>

  <div class="card">
    <div class="card-head">
      <h3 class="card-title">Case Records</h3>
      <a class="btn btn-outline btn-sm" href="/admin/records/<%= b.sector_slug %>/new?beneficiary=<%= b.id %>">Add case</a>
    </div>
    <div class="card-body">
      <div class="bar-list">
        <div class="bar-row"><span class="bar-label">Juvenile</span><div class="bar-track"><div class="bar-fill" style="width:<%= Math.min(100, Math.max(6, b.juvenile_count * 12)) %>%"><%= b.juvenile_count %></div></div></div>
        <div class="bar-row"><span class="bar-label">Solo Parents</span><div class="bar-track"><div class="bar-fill" style="width:<%= Math.min(100, Math.max(6, b.sp_count * 12)) %>%"><%= b.sp_count %></div></div></div>
        <div class="bar-row"><span class="bar-label">Senior Citizens</span><div class="bar-track"><div class="bar-fill" style="width:<%= Math.min(100, Math.max(6, b.sc_count * 12)) %>%"><%= b.sc_count %></div></div></div>
        <div class="bar-row"><span class="bar-label">PWD</span><div class="bar-track"><div class="bar-fill dark" style="width:<%= Math.min(100, Math.max(6, b.pwd_count * 12)) %>%"><%= b.pwd_count %></div></div></div>
      </div>
    </div>
  </div>
</div>

<div class="grid-2">
  <div class="card">
    <div class="card-head"><h3 class="card-title">Household / Family Composition</h3></div>
    <div class="card-body">
      <form method="POST" action="/admin/beneficiaries/<%= b.id %>/household" class="inline-form" style="display:flex; gap:8px; flex-wrap:wrap; margin-bottom:12px;">
        <input type="hidden" name="_csrf" value="<%= csrfToken %>">
        <input name="member_name" class="form-control" placeholder="Member name *" required style="min-width:160px; flex:1;">
        <input name="relation" class="form-control" placeholder="Relation" style="min-width:110px;">
        <input name="date_of_birth" type="date" class="form-control" style="width:140px;">
        <select name="sex" class="form-control" style="width:110px;">
          <option value="">Sex</option><option>Male</option><option>Female</option><option>Other</option>
        </select>
        <input name="occupation" class="form-control" placeholder="Occupation" style="min-width:120px; flex:1;">
        <button type="submit" class="btn btn-primary">Add</button>
      </form>
      <% if (household.length === 0) { %>
        <div class="empty-state"><p>No household members listed.</p></div>
      <% } else { %>
        <div class="table-wrap">
          <table class="table">
            <thead><tr><th>Member</th><th>Relation</th><th>Birth Date</th><th>Sex</th><th>Occupation</th><th></th></tr></thead>
            <tbody>
              <% household.forEach(function(m) { %>
                <tr>
                  <td><strong><%= m.member_name %></strong></td>
                  <td><%= m.relation || '—' %></td>
                  <td><%= h.formatDisplayDate(m.date_of_birth) %></td>
                  <td><%= m.sex || '—' %></td>
                  <td><%= m.occupation || '—' %></td>
                  <td>
                    <form method="POST" action="/admin/beneficiaries/<%= b.id %>/household/<%= m.id %>/delete" data-confirm="Remove this household member?">
                      <input type="hidden" name="_csrf" value="<%= csrfToken %>">
                      <button type="submit" class="btn btn-outline" style="padding:4px 9px;">Remove</button>
                    </form>
                  </td>
                </tr>
              <% }) %>
            </tbody>
          </table>
        </div>
      <% } %>
    </div>
  </div>

  <div class="card">
    <div class="card-head"><h3 class="card-title">Services / Interventions Provided</h3></div>
    <div class="card-body">
      <form method="POST" action="/admin/beneficiaries/<%= b.id %>/services" class="inline-form" style="display:flex; gap:8px; flex-wrap:wrap; margin-bottom:12px;">
        <input type="hidden" name="_csrf" value="<%= csrfToken %>">
        <select name="service_id" class="form-control" required style="min-width:180px; flex:1;">
          <option value="">-- Select service --</option>
          <% catalog.forEach(function(s) { %>
            <option value="<%= s.id %>"><%= s.name %><%= s.sector_name ? ' (' + s.sector_name + ')' : '' %></option>
          <% }) %>
        </select>
        <input name="date_provided" type="date" class="form-control" style="width:150px;">
        <button type="submit" class="btn btn-primary">Record</button>
      </form>
      <% if (provided.length === 0) { %>
        <div class="empty-state"><p>No services recorded yet.</p></div>
      <% } else { %>
        <ul class="timeline">
          <% provided.forEach(function(p) { %>
            <li class="timeline-item">
              <div class="timeline-head">
                <span class="timeline-actor"><strong><%= p.service_name %></strong> <span class="badge badge-blue"><%= p.status %></span></span>
                <span class="timeline-time"><%= h.formatDisplayDate(p.date_provided) %></span>
              </div>
              <p class="timeline-body"><%= p.details || '—' %> <span class="muted">by <%= p.provided_first ? p.provided_first + ' ' + p.provided_last : '—' %></span></p>
            </li>
          <% }) %>
        </ul>
      <% } %>
    </div>
  </div>
</div>

<div class="grid-2">
  <div class="card">
    <div class="card-head"><h3 class="card-title">Case Notes</h3></div>
    <div class="card-body">
      <% if (notes.length === 0) { %>
        <div class="empty-state"><p>No notes recorded for this beneficiary.</p></div>
      <% } else { %>
        <ul class="timeline">
          <% notes.forEach(function(n) { %>
            <li class="timeline-item">
              <div class="timeline-head">
                <span class="timeline-actor"><%= n.first_name %> <%= n.last_name %> <span class="muted">(<%= n.role_name %>)</span></span>
                <span class="timeline-time"><%= h.formatDateTime(n.created_at) %></span>
              </div>
              <p class="timeline-body"><%= n.note %></p>
            </li>
          <% }) %>
        </ul>
      <% } %>
    </div>
  </div>

  <div class="card">
    <div class="card-head"><h3 class="card-title">Documents</h3></div>
    <div class="card-body">
      <form method="POST" action="/admin/beneficiaries/<%= b.id %>/documents" enctype="multipart/form-data" class="inline-form" style="display:flex; gap:8px; flex-wrap:wrap; margin-bottom:12px;">
        <input type="hidden" name="_csrf" value="<%= csrfToken %>">
        <input name="document_name" class="form-control" placeholder="Document name" style="min-width:140px; flex:1;">
        <input name="document_type" class="form-control" placeholder="Type (e.g. PSA, ID)" style="width:140px;">
        <input name="file" type="file" class="form-control" required style="flex:1; min-width:140px;">
        <button type="submit" class="btn btn-primary">Upload</button>
      </form>
      <% if (documents.length === 0) { %>
        <div class="empty-state"><p>No documents uploaded.</p></div>
      <% } else { %>
        <% documents.forEach(function(d) { %>
          <div class="file-item">
            <span class="file-ico"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.9" stroke-linecap="round" stroke-linejoin="round"><path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z"/><polyline points="14 2 14 8 20 8"/></svg></span>
            <div style="min-width:0;flex:1">
              <a class="file-name" href="<%= d.file_path %>" target="_blank"><%= d.document_name %></a>
              <div class="file-meta"><%= d.document_type || 'General' %> &middot; <%= d.first_name ? d.first_name + ' ' + d.last_name + ' &middot; ' : '' %><%= h.formatDisplayDate(d.created_at) %></div>
            </div>
            <form method="POST" action="/admin/beneficiaries/<%= b.id %>/documents/<%= d.id %>/delete" data-confirm="Delete this document?">
              <input type="hidden" name="_csrf" value="<%= csrfToken %>">
              <button type="submit" class="btn btn-outline" style="padding:4px 9px;">Delete</button>
            </form>
          </div>
        <% }) %>
      <% } %>
    </div>
  </div>
</div>