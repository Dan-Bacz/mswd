<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <meta name="theme-color" content="#0B5ED7">
  <meta name="description" content="Mahayag Social Welfare and Development Management System - Officer Registration">
  <meta name="robots" content="noindex, nofollow">
  <title><%= typeof title !== 'undefined' ? title : 'Officer Registration | Mahayag MSWD Management System' %></title>
  <style>
    :root {
      --blue: #0B5ED7;
      --blue-strong: #0A4FC0;
      --blue-dark: #073B7A;
      --blue-deep: #062E60;
      --navy: #12355B;
      --muted: #6B7C93;
      --border: #D8E3F0;
      --light: #EAF3FF;
      --white: #FFFFFF;
      --danger-soft: #FDF0EF;
      --danger-border: #F5C6C2;
      --danger-text: #B42318;
      --success-soft: #EFFCF4;
      --success-border: #BCEBD2;
      --success-text: #12683B;
      --radius-lg: 22px;
      --radius-md: 12px;
      --shadow-card: 0 18px 50px rgba(7, 59, 122, 0.14), 0 4px 14px rgba(7, 59, 122, 0.08);
    }

    html, body {
      margin: 0;
      padding: 0;
      overflow-x: hidden;
      min-height: 100%;
    }

    body {
      font-family: -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, "Helvetica Neue", Arial, sans-serif;
      background: linear-gradient(160deg, #062E60 0%, #073B7A 34%, #0B5ED7 100%);
      color: var(--navy);
      line-height: 1.55;
      -webkit-font-smoothing: antialiased;
      text-rendering: optimizeLegibility;
    }

    *, *::before, *::after { box-sizing: border-box; }

    a { color: var(--blue); text-decoration: none; }
    a:hover { color: var(--blue-dark); text-decoration: underline; }

    .auth-shell {
      display: flex;
      flex-direction: column;
      align-items: center;
      justify-content: center;
      min-height: 100vh;
      padding: 32px 18px;
    }

    .auth-head { text-align: center; margin-bottom: 22px; }

    .brand-mark {
      width: 58px;
      height: 58px;
      margin: 0 auto 14px;
      border-radius: 16px;
      background: linear-gradient(145deg, var(--blue-strong) 0%, var(--blue-dark) 100%);
      border: 1px solid rgba(255, 255, 255, 0.9);
      box-shadow: 0 10px 24px rgba(6, 46, 96, 0.35);
      color: var(--white);
      display: flex;
      align-items: center;
      justify-content: center;
    }

    .auth-head h1 {
      font-size: 24px;
      font-weight: 800;
      letter-spacing: 1.2px;
      color: var(--white);
      margin: 0 0 3px;
      text-transform: uppercase;
      line-height: 1.15;
    }

    .auth-head .auth-sub {
      font-size: 13.5px;
      font-weight: 600;
      color: rgba(255, 255, 255, 0.85);
      letter-spacing: 0.4px;
      margin: 0;
    }

    .auth-card {
      width: min(100%, 720px);
      background: var(--white);
      border: 1px solid var(--border);
      border-radius: var(--radius-lg);
      box-shadow: var(--shadow-card);
      padding: 34px 36px 26px;
    }

    .auth-card h3 {
      font-size: 19px;
      font-weight: 800;
      color: var(--navy);
      margin: 0 0 4px;
    }

    .auth-intro {
      font-size: 13.5px;
      color: var(--muted);
      margin: 0 0 22px;
      line-height: 1.6;
    }

    .auth-alert {
      display: flex;
      align-items: flex-start;
      gap: 10px;
      padding: 12px 14px;
      border-radius: var(--radius-md);
      margin-bottom: 18px;
      font-size: 13.5px;
      line-height: 1.5;
    }

    .auth-alert-error {
      background: var(--danger-soft);
      border: 1px solid var(--danger-border);
      color: var(--danger-text);
    }

    .auth-alert-success {
      background: var(--success-soft);
      border: 1px solid var(--success-border);
      color: var(--success-text);
    }

    .auth-alert svg {
      width: 19px;
      height: 19px;
      flex-shrink: 0;
      margin-top: 1px;
    }

    .form-row {
      display: grid;
      grid-template-columns: 1fr 1fr;
      gap: 0 18px;
    }

    .form-group { margin-bottom: 16px; }

    .form-group label {
      display: block;
      font-size: 13.5px;
      font-weight: 600;
      color: var(--navy);
      margin-bottom: 7px;
    }

    .required { color: var(--blue); }

    .form-control {
      width: 100%;
      height: 46px;
      padding: 0 14px;
      font-size: 14.5px;
      font-family: inherit;
      color: var(--navy);
      background: var(--white);
      border: 1px solid var(--border);
      border-radius: var(--radius-md);
      transition: border-color 0.16s ease, box-shadow 0.16s ease;
    }

    select.form-control { cursor: pointer; }

    .form-control::placeholder { color: #9DB0C6; opacity: 1; }

    .form-control:focus {
      outline: none;
      border-color: var(--blue);
      box-shadow: 0 0 0 4px rgba(11, 94, 215, 0.14);
    }

    .form-control:focus-visible { outline: 2px solid var(--blue); outline-offset: 1px; }

    .form-text {
      font-size: 12.5px;
      color: var(--muted);
      margin-top: 6px;
    }

    .auth-btn {
      display: flex;
      align-items: center;
      justify-content: center;
      gap: 9px;
      width: 100%;
      height: 51px;
      margin-top: 6px;
      border: none;
      border-radius: var(--radius-md);
      background: linear-gradient(180deg, var(--blue-strong) 0%, var(--blue) 55%, var(--blue-dark) 100%);
      color: var(--white);
      font-size: 15px;
      font-weight: 700;
      font-family: inherit;
      letter-spacing: 0.8px;
      text-transform: uppercase;
      cursor: pointer;
      box-shadow: 0 10px 22px rgba(11, 94, 215, 0.3);
      transition: transform 0.14s ease, box-shadow 0.16s ease, background 0.16s ease;
    }

    .auth-btn:hover {
      background: linear-gradient(180deg, var(--blue) 0%, var(--blue-dark) 100%);
      transform: translateY(-1px);
      box-shadow: 0 14px 28px rgba(11, 94, 215, 0.36);
    }

    .auth-btn:active { transform: translateY(0); box-shadow: 0 6px 14px rgba(11, 94, 215, 0.28); }

    .auth-btn:focus-visible { outline: 2px solid var(--navy); outline-offset: 3px; }

    .auth-foot {
      text-align: center;
      margin: 18px 0 0;
      font-size: 13.5px;
      color: var(--muted);
    }

    .auth-foot a { font-weight: 700; }

    @media (max-width: 560px) {
      .form-row { grid-template-columns: 1fr; gap: 0; }
      .auth-shell { justify-content: flex-start; padding: 24px 14px; }
      .auth-card { padding: 28px 22px 24px; border-radius: 18px; }
      .form-control { height: 48px; }
      .auth-btn { height: 52px; }
    }
  </style>
</head>
<body>
  <div class="auth-shell">
    <header class="auth-head">
      <div class="brand-mark">
        <svg width="28" height="28" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
          <path d="M20.84 4.61a5.5 5.5 0 0 0-7.78 0L12 5.67l-1.06-1.06a5.5 5.5 0 0 0-7.78 7.78l1.06 1.06L12 21.23l7.78-7.78 1.06-1.06a5.5 5.5 0 0 0 0-7.78z"/>
        </svg>
      </div>
      <h1>Mahayag</h1>
      <p class="auth-sub">Social Welfare and Development</p>
    </header>

    <div class="auth-card">
      <h3>Officer Registration</h3>
      <p class="auth-intro">Register to request a sector officer account. Your account must be approved by the administrator.</p>

      <% if (flashMessages && flashMessages.success && flashMessages.success.length) { %>
        <div class="auth-alert auth-alert-success" role="alert">
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
            <path d="M22 11.08V12a10 10 0 1 1-5.93-9.14"/><polyline points="22 4 12 14.01 9 11.01"/>
          </svg>
          <span><%= flashMessages.success.join('<br>') %></span>
        </div>
      <% } %>

      <% if (flashMessages && flashMessages.error && flashMessages.error.length) { %>
        <div class="auth-alert auth-alert-error" role="alert">
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
            <path d="M10.29 3.86 1.82 18a2 2 0 0 0 1.71 3h16.94a2 2 0 0 0 1.71-3L13.71 3.86a2 2 0 0 0-3.42 0z"/>
            <line x1="12" y1="9" x2="12" y2="13"/><line x1="12" y1="17" x2="12.01" y2="17"/>
          </svg>
          <span><%= flashMessages.error.join('<br>') %></span>
        </div>
      <% } %>

      <form method="POST" action="/auth/register">
        <input type="hidden" name="_csrf" value="<%= csrfToken() %>">

        <div class="form-group">
          <label for="sector_id">Sector <span class="required">*</span></label>
          <select id="sector_id" name="sector_id" class="form-control" required>
            <option value="">-- Select Sector --</option>
            <% sectors.forEach(function(s) { %>
              <option value="<%= s.id %>"><%= s.name %></option>
            <% }) %>
          </select>
        </div>

        <div class="form-row">
          <div class="form-group">
            <label for="first_name">First Name <span class="required">*</span></label>
            <input type="text" id="first_name" name="first_name" class="form-control" required>
          </div>
          <div class="form-group">
            <label for="middle_name">Middle Name</label>
            <input type="text" id="middle_name" name="middle_name" class="form-control">
          </div>
        </div>

        <div class="form-row">
          <div class="form-group">
            <label for="last_name">Last Name <span class="required">*</span></label>
            <input type="text" id="last_name" name="last_name" class="form-control" required>
          </div>
          <div class="form-group">
            <label for="suffix">Suffix</label>
            <input type="text" id="suffix" name="suffix" class="form-control" placeholder="Jr., Sr., III">
          </div>
        </div>

        <div class="form-group">
          <label for="contact_number">Contact Number</label>
          <input type="text" id="contact_number" name="contact_number" class="form-control" placeholder="09XXXXXXXXX">
        </div>

        <div class="form-row">
          <div class="form-group">
            <label for="username">Username <span class="required">*</span></label>
            <input type="text" id="username" name="username" class="form-control" required>
          </div>
          <div class="form-group">
            <label for="email">Email <span class="required">*</span></label>
            <input type="email" id="email" name="email" class="form-control" required>
          </div>
        </div>

        <div class="form-row">
          <div class="form-group">
            <label for="password">Password <span class="required">*</span></label>
            <input type="password" id="password" name="password" class="form-control" required>
            <div class="form-text">Minimum 8 characters.</div>
          </div>
          <div class="form-group">
            <label for="password2">Confirm Password <span class="required">*</span></label>
            <input type="password" id="password2" name="password2" class="form-control" required>
          </div>
        </div>

        <button type="submit" class="auth-btn">Submit Registration</button>
        <p class="auth-foot">
          Already have an account? <a href="/login">Login</a>
        </p>
      </form>
    </div>
  </div>
</body>
</html>