<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <meta name="description" content="Municipal Social Welfare and Development Management System">
  <title><%= typeof title !== 'undefined' ? title : 'MSWD Management System' %></title>
  <link rel="stylesheet" href="/css/style.css">
</head>
<body class="auth-body">
  <main class="auth-card">
    <div class="auth-header">
      <div class="auth-logo">MSWD</div>
      <h2>Municipal Social Welfare & Development</h2>
      <p>Mahayag Municipal Office</p>
    </div>
    <div class="auth-body-inner">
      <% if (flashMessages) { %>
        <% if (flashMessages.success && flashMessages.success.length) { %>
          <div class="flash flash-success"><%= flashMessages.success.join('<br>') %></div>
        <% } %>
        <% if (flashMessages.error && flashMessages.error.length) { %>
          <div class="flash flash-error"><%= flashMessages.error.join('<br>') %></div>
        <% } %>
        <% if (flashMessages.warning && flashMessages.warning.length) { %>
          <div class="flash flash-warning"><%= flashMessages.warning.join('<br>') %></div>
        <% } %>
      <% } %>
      <%- body %>
    </div>
    <div class="auth-footer">
      &copy; <%= new Date().getFullYear() %> MSWD Mahayag. All rights reserved.<br>
      Municipal Social Welfare and Development Office
    </div>
  </main>
</body>
</html>