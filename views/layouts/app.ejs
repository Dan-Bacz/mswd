<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <meta name="theme-color" content="#0B5ED7">
  <meta name="description" content="Mahayag Social Welfare and Development Management System">
  <link rel="icon" href="/images/mswd.png" type="image/png">
  <title><%= typeof pageTitle !== 'undefined' && pageTitle ? pageTitle + ' | MSWD' : (typeof title !== 'undefined' ? title + ' | MSWD' : 'MSWD Management System') %></title>
  <link rel="stylesheet" href="/css/app.css">
</head>
<body class="app-body">
  <div class="app-shell">

    <!-- SIDEBAR -->
    <aside class="sidebar">
      <div class="sidebar-brand">
        <span class="sidebar-mark"><img src="/images/mswd.png" alt="MSWD Mahayag logo"></span>
        <div class="sidebar-brand-text">
          <span class="sidebar-brand-name">MSWD Mahayag</span>
          <span class="sidebar-brand-sub">Management System</span>
        </div>
      </div>

      <nav class="sidebar-nav" aria-label="Main navigation">
        <% if (user.role === 'admin') { %>
          <span class="nav-section-label">Main</span>
          <a class="sidebar-link <%= active === 'dashboard' ? 'active' : '' %>" href="/admin">
            <svg class="nav-ico" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.9" stroke-linecap="round" stroke-linejoin="round"><rect x="3" y="3" width="7" height="9" rx="1"/><rect x="14" y="3" width="7" height="5" rx="1"/><rect x="14" y="12" width="7" height="9" rx="1"/><rect x="3" y="16" width="7" height="5" rx="1"/></svg>
            Dashboard
          </a>
          <a class="sidebar-link <%= active === 'beneficiaries' ? 'active' : '' %>" href="/admin/beneficiaries">
            <svg class="nav-ico" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.9" stroke-linecap="round" stroke-linejoin="round"><path d="M17 21v-2a4 4 0 0 0-4-4H5a4 4 0 0 0-4 4v2"/><circle cx="9" cy="7" r="4"/><path d="M23 21v-2a4 4 0 0 0-3-3.87"/><path d="M16 3.13a4 4 0 0 1 0 7.75"/></svg>
            Beneficiaries
          </a>
          <a class="sidebar-link <%= active === 'records' ? 'active' : '' %>" href="/admin/records/juvenile">
            <svg class="nav-ico" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.9" stroke-linecap="round" stroke-linejoin="round"><path d="M22 11.08V12a10 10 0 1 1-5.93-9.14"/><polyline points="22 4 12 14.01 9 11.01"/></svg>
            Records &amp; Cases
          </a>
          <div class="nav-sub">
            <a class="sidebar-link sub <%= active === 'juvenile' ? 'active' : '' %>" href="/admin/records/juvenile">Juvenile</a>
            <a class="sidebar-link sub <%= active === 'solo-parent' ? 'active' : '' %>" href="/admin/records/solo-parent">Solo Parents</a>
            <a class="sidebar-link sub <%= active === 'senior-citizens' ? 'active' : '' %>" href="/admin/records/senior-citizens">Senior Citizens</a>
            <a class="sidebar-link sub <%= active === 'pwd' ? 'active' : '' %>" href="/admin/records/pwd">PWD</a>
          </div>
<span class="nav-section-label">Management</span>
          <a class="sidebar-link <%= active === 'officers' ? 'active' : '' %>" href="/admin/officers">
            <svg class="nav-ico" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.9" stroke-linecap="round" stroke-linejoin="round"><path d="M17 21v-2a4 4 0 0 0-4-4H5a4 4 0 0 0-4 4v2"/><circle cx="9" cy="7" r="4"/><path d="M23 21v-2a4 4 0 0 0-3-3.87"/></svg>
            Officers
          </a>
          <a class="sidebar-link <%= active === 'sectors' ? 'active' : '' %>" href="/admin/sectors">
            <svg class="nav-ico" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.9" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="10"/><line x1="2" y1="12" x2="22" y2="12"/><path d="M12 2a15.3 15.3 0 0 1 4 10 15.3 15.3 0 0 1-4 10 15.3 15.3 0 0 1-4-10 15.3 15.3 0 0 1 4-10z"/></svg>
            Sectors
          </a>
          <a class="sidebar-link <%= active === 'services' ? 'active' : '' %>" href="/admin/services">
            <svg class="nav-ico" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.9" stroke-linecap="round" stroke-linejoin="round"><path d="M14.7 6.3a1 1 0 0 0 0 1.4l1.6 1.6a1 1 0 0 0 1.4 0l3.77-3.77a6 6 0 0 1-7.94 7.94l-6.91 6.91a2.12 2.12 0 0 1-3-3l6.91-6.91a6 6 0 0 1 7.94-7.94l-3.76 3.76z"/></svg>
            Services
          </a>
          <a class="sidebar-link <%= active === 'requests' ? 'active' : '' %>" href="/admin/users?filter=pending">
            <svg class="nav-ico" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.9" stroke-linecap="round" stroke-linejoin="round"><rect x="3" y="4" width="18" height="16" rx="2"/><path d="m3 8 9 6 9-6"/></svg>
            Approval Requests
          </a>
          <a class="sidebar-link <%= active === 'users' ? 'active' : '' %>" href="/admin/users">
            <svg class="nav-ico" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.9" stroke-linecap="round" stroke-linejoin="round"><path d="M20 21v-2a4 4 0 0 0-4-4H8a4 4 0 0 0-4 4v2"/><circle cx="12" cy="7" r="4"/></svg>
            Users
          </a>

          <span class="nav-section-label">System</span>
          <a class="sidebar-link <%= active === 'reports' ? 'active' : '' %>" href="/admin/reports">
            <svg class="nav-ico" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.9" stroke-linecap="round" stroke-linejoin="round"><path d="M18 20V10"/><path d="M12 20V4"/><path d="M6 20v-6"/></svg>
            Reports
          </a>
          <div class="nav-sub">
            <a class="sidebar-link sub <%= active === 'reports-monthly' ? 'active' : '' %>" href="/admin/reports/monthly">Monthly Report</a>
          </div>
          <a class="sidebar-link <%= active === 'audit' ? 'active' : '' %>" href="/admin/audit-log">
            <svg class="nav-ico" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.9" stroke-linecap="round" stroke-linejoin="round"><path d="M12 8v4l3 3"/><circle cx="12" cy="12" r="10"/></svg>
            Audit Log
          </a>
          <a class="sidebar-link <%= active === 'settings' ? 'active' : '' %>" href="/admin/settings">
            <svg class="nav-ico" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.9" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="3"/><path d="M19.4 15a1.65 1.65 0 0 0 .33 1.82l.06.06a2 2 0 1 1-2.83 2.83l-.06-.06a1.65 1.65 0 0 0-1.82-.33 1.65 1.65 0 0 0-1 1.51V21a2 2 0 1 1-4 0v-.09A1.65 1.65 0 0 0 9 19.4a1.65 1.65 0 0 0-1.82.33l-.06.06a2 2 0 1 1-2.83-2.83l.06-.06a1.65 1.65 0 0 0 .33-1.82 1.65 1.65 0 0 0-1.51-1H3a2 2 0 1 1 0-4h.09A1.65 1.65 0 0 0 4.6 9a1.65 1.65 0 0 0-.33-1.82l-.06-.06a2 2 0 1 1 2.83-2.83l.06.06a1.65 1.65 0 0 0 1.82.33H9a1.65 1.65 0 0 0 1-1.51V3a2 2 0 1 1 4 0v.09a1.65 1.65 0 0 0 1 1.51 1.65 1.65 0 0 0 1.82-.33l.06-.06a2 2 0 1 1 2.83 2.83l-.06.06a1.65 1.65 0 0 0-.33 1.82V9a1.65 1.65 0 0 0 1.51 1H21a2 2 0 1 1 0 4h-.09a1.65 1.65 0 0 0-1.51 1z"/></svg>
            Settings
          </a>
        <% } else { %>
          <span class="nav-section-label">Main</span>
          <a class="sidebar-link <%= active === 'dashboard' ? 'active' : '' %>" href="/officer">
            <svg class="nav-ico" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.9" stroke-linecap="round" stroke-linejoin="round"><rect x="3" y="3" width="7" height="9" rx="1"/><rect x="14" y="3" width="7" height="5" rx="1"/><rect x="14" y="12" width="7" height="9" rx="1"/><rect x="3" y="16" width="7" height="5" rx="1"/></svg>
            Dashboard
          </a>
          <a class="sidebar-link <%= active === 'beneficiaries' ? 'active' : '' %>" href="/officer/beneficiaries">
            <svg class="nav-ico" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.9" stroke-linecap="round" stroke-linejoin="round"><path d="M17 21v-2a4 4 0 0 0-4-4H5a4 4 0 0 0-4 4v2"/><circle cx="9" cy="7" r="4"/><path d="M23 21v-2a4 4 0 0 0-3-3.87"/><path d="M16 3.13a4 4 0 0 1 0 7.75"/></svg>
            Beneficiaries
          </a>
          <a class="sidebar-link <%= active === 'cases' ? 'active' : '' %>" href="/officer/cases">
            <svg class="nav-ico" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.9" stroke-linecap="round" stroke-linejoin="round"><path d="M22 11.08V12a10 10 0 1 1-5.93-9.14"/><polyline points="22 4 12 14.01 9 11.01"/></svg>
            Cases
          </a>
          <% if (allowedSector) { %>
            <span class="nav-sector-chip"><%= allowedSector.name %></span>
          <% } %>

          <span class="nav-section-label">Work</span>
          <a class="sidebar-link <%= active === 'reports' ? 'active' : '' %>" href="/officer/reports">
            <svg class="nav-ico" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.9" stroke-linecap="round" stroke-linejoin="round"><path d="M18 20V10"/><path d="M12 20V4"/><path d="M6 20v-6"/></svg>
            Reports
          </a>
          <div class="nav-sub">
            <a class="sidebar-link sub <%= active === 'reports-monthly' ? 'active' : '' %>" href="/officer/reports/monthly">Monthly Report</a>
          </div>
          <a class="sidebar-link <%= active === 'profile' ? 'active' : '' %>" href="/officer/profile">
            <svg class="nav-ico" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.9" stroke-linecap="round" stroke-linejoin="round"><path d="M20 21v-2a4 4 0 0 0-4-4H8a4 4 0 0 0-4 4v2"/><circle cx="12" cy="7" r="4"/></svg>
            My Profile
          </a>
        <% } %>

        <span class="nav-section-label">Account</span>
        <a class="sidebar-link <%= active === 'notifications' ? 'active' : '' %>" href="<%= user.role === 'admin' ? '/admin/notifications' : '/officer/notifications' %>">
          <svg class="nav-ico" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.9" stroke-linecap="round" stroke-linejoin="round"><path d="M18 8a6 6 0 0 0-12 0c0 7-3 9-3 9h18s-3-2-3-9"/><path d="M13.73 21a2 2 0 0 1-3.46 0"/></svg>
          Notifications
          <% if (unreadCount > 0) { %><span class="nav-badge"><%= unreadCount %></span><% } %>
        </a>
      </nav>

      <div class="sidebar-foot">
        <div class="sidebar-user">
          <span class="avatar"><%= (user.first_name || user.username || 'U').charAt(0).toUpperCase() %></span>
          <div class="sidebar-user-meta">
            <div class="sidebar-user-name"><%= user.first_name %> <%= user.last_name %></div>
            <div class="sidebar-user-role"><%= user.role === 'admin' ? 'Administrator' : 'Sector Officer' %><% if (allowedSector) { %> &middot; <%= allowedSector.name %><% } %></div>
          </div>
        </div>
        <form method="POST" action="/logout" class="logout-form">
          <input type="hidden" name="_csrf" value="<%= csrfToken %>">
          <button type="submit" class="logout-btn" title="Sign out">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M9 21H5a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h4"/><polyline points="16 17 21 12 16 7"/><line x1="21" y1="12" x2="9" y2="12"/></svg>
          </button>
        </form>
      </div>
    </aside>
<!-- MAIN -->
    <div class="app-main">
      <header class="app-header">
        <button class="icon-btn sidebar-toggle" id="sidebarToggle" aria-label="Toggle sidebar">
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><line x1="3" y1="12" x2="21" y2="12"/><line x1="3" y1="6" x2="21" y2="6"/><line x1="3" y1="18" x2="21" y2="18"/></svg>
        </button>

        <div class="header-title">
          <span class="header-org"><%= municipality %></span>
          <span class="header-page"><%= typeof pageTitle !== 'undefined' && pageTitle ? pageTitle : (typeof title !== 'undefined' ? title : 'Dashboard') %></span>
        </div>

        <div class="header-actions">
          <div class="dropdown">
            <button class="icon-btn bell-btn" id="bellBtn" aria-label="Notifications">
              <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M18 8a6 6 0 0 0-12 0c0 7-3 9-3 9h18s-3-2-3-9"/><path d="M13.73 21a2 2 0 0 1-3.46 0"/></svg>
              <% if (unreadCount > 0) { %><span class="bell-dot"><%= unreadCount > 9 ? '9+' : unreadCount %></span><% } %>
            </button>
            <div class="dropdown-panel notif-panel" id="bellPanel">
              <div class="dropdown-head">
                <span>Notifications</span>
                <form method="POST" action="<%= user.role === 'admin' ? '/admin/notifications/read-all' : '/officer/notifications/read-all' %>">
                  <input type="hidden" name="_csrf" value="<%= csrfToken %>">
                  <button type="submit" class="link-btn">Mark all read</button>
                </form>
              </div>
              <div class="notif-list">
                <% if (latestNotifs.length === 0) { %>
                  <div class="notif-empty">No notifications yet.</div>
                <% } else { %>
                  <% latestNotifs.forEach(function(n) { %>
                    <a class="notif-item <%= n.is_read ? '' : 'unread' %>" href="<%= n.link || '#' %>">
                      <span class="notif-dot type-<%= n.type %>"></span>
                      <div class="notif-body">
                        <div class="notif-title"><%= n.title %></div>
                        <div class="notif-msg"><%= n.message || '' %></div>
                      </div>
                    </a>
                  <% }) %>
                <% } %>
              </div>
              <div class="dropdown-foot">
                <a class="link-btn" href="<%= user.role === 'admin' ? '/admin/notifications' : '/officer/notifications' %>">View all notifications</a>
              </div>
            </div>
          </div>

          <div class="header-user">
            <span class="avatar"><%= (user.first_name || user.username || 'U').charAt(0).toUpperCase() %></span>
            <div class="header-user-meta">
              <span class="header-user-name"><%= user.first_name %> <%= user.last_name %></span>
              <span class="header-user-role"><%= user.role === 'admin' ? 'Administrator' : 'Sector Officer' %></span>
            </div>
          </div>
        </div>
      </header>

      <main class="app-content">
        <% if (success) { %>
          <div class="alert alert-success" role="alert">
            <svg class="alert-ico" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M22 11.08V12a10 10 0 1 1-5.93-9.14"/><polyline points="22 4 12 14.01 9 11.01"/></svg>
            <span><%= success %></span>
          </div>
        <% } %>
        <% if (warning) { %>
          <div class="alert alert-warning" role="alert">
            <svg class="alert-ico" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><path d="M10.29 3.86 1.82 18a2 2 0 0 0 1.71 3h16.94a2 2 0 0 0 1.71-3L13.71 3.86a2 2 0 0 0-3.42 0z"/><line x1="12" y1="9" x2="12" y2="13"/><line x1="12" y1="17" x2="12.01" y2="17"/></svg>
            <span><%= warning %></span>
          </div>
        <% } %>
        <% if (error) { %>
          <div class="alert alert-danger" role="alert">
            <svg class="alert-ico" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><path d="M10.29 3.86 1.82 18a2 2 0 0 0 1.71 3h16.94a2 2 0 0 0 1.71-3L13.71 3.86a2 2 0 0 0-3.42 0z"/><line x1="12" y1="9" x2="12" y2="13"/><line x1="12" y1="17" x2="12.01" y2="17"/></svg>
            <span><%= error %></span>
          </div>
        <% } %>

        <%- body %>
      </main>

      <footer class="app-footer">
        <span><%= systemName %></span>
        <span class="app-footer-dot">&bull;</span>
        <span><%= municipality %></span>
      </footer>
    </div>
  </div>

  <script src="/js/app.js"></script>
</body>
</html>