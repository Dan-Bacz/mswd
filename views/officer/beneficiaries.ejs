<% var pageTitle = 'Beneficiaries'; var title = 'Beneficiaries'; %>

<div class="page-head">
  <div>
    <h1 class="page-title"><%= allowedSector ? allowedSector.name : '' %> — Beneficiaries</h1>
    <p class="page-sub">Beneficiaries registered under your assigned sector.</p>
  </div>
  <a class="btn btn-primary" href="/officer/beneficiaries/new">
    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round"><line x1="12" y1="5" x2="12" y2="19"/><line x1="5" y1="12" x2="19" y2="12"/></svg>
    Register Beneficiary
  </a>
</div>

<div class="card">
  <div class="toolbar">
    <form method="GET" action="/officer/beneficiaries">
      <input type="text" name="search" value="<%= search %>" class="form-control compact" style="min-width:200px" placeholder="Search name or barangay...">
      <select name="barangay" class="form-control compact">
        <option value="">All barangays</option>
        <% barangays.forEach(function(b) { %>
          <option value="<%= b %>" <%= barangay === b ? 'selected' : '' %>><%= b %></option>
        <% }) %>
      </select>
      <select name="status" class="form-control compact">
        <option value="all">All statuses</option>
        <% ['Active', 'Inactive', 'Archived'].forEach(function(st) { %>
          <option value="<%= st %>" <%= status === st ? 'selected' : '' %>><%= st %></option>
        <% }) %>
      </select>
      <button type="submit" class="btn btn-outline">Filter</button>
    </form>
  </div>

  <div class="card-body flush">
    <% if (rows.length === 0) { %>
      <div class="empty-state"><p>No beneficiaries found.</p></div>
    <% } else { %>
      <div class="table-wrap">
        <table class="table">
          <thead>
            <tr>
              <th>Beneficiary</th><th>Number</th><th>Barangay</th><th>Age / Sex</th><th>Records</th><th>Status</th><th></th>
            </tr>
          </thead>
          <tbody>
            <% rows.forEach(function(b) { %>
              <tr>
                <td class="row-primary"><a href="/officer/beneficiaries/<%= b.id %>"><%= h.fullName(b) %></a></td>
                <td class="row-muted"><%= b.beneficiary_number %></td>
                <td><%= b.barangay || '—' %></td>
                <td class="row-muted"><%= b.date_of_birth ? h.calculateAge(b.date_of_birth) : '—' %> / <%= b.sex || '—' %></td>
                <td><%= b.juvenile_count + b.sp_count + b.sc_count + b.pwd_count %></td>
                <td><span class="badge <%= b.status === 'Active' ? 'badge-green' : b.status === 'Inactive' ? 'badge-gray' : 'badge-red' %>"><%= b.status %></span></td>
                <td>
                  <div class="row-actions">
                    <a class="btn btn-ghost btn-sm" href="/officer/beneficiaries/<%= b.id %>">View</a>
                    <a class="btn btn-ghost btn-sm" href="/officer/beneficiaries/<%= b.id %>/edit">Edit</a>
                  </div>
                </td>
              </tr>
            <% }) %>
          </tbody>
        </table>
      </div>
    <% } %>
  </div>

  <div class="pagination">
    <% if (pg.totalPages > 1) { %>
      <% if (pg.hasPrev) { %><a class="page-link" href="/officer/beneficiaries?page=<%= pg.page - 1 %>">&laquo;</a><% } %>
      <% for (var p = Math.max(1, pg.page - 2); p <= Math.min(pg.totalPages, pg.page + 2); p++) { %>
        <a class="page-link <%= p === pg.page ? 'current' : '' %>" href="/officer/beneficiaries?page=<%= p %>"><%= p %></a>
      <% } %>
      <% if (pg.hasNext) { %><a class="page-link" href="/officer/beneficiaries?page=<%= pg.page + 1 %>">&raquo;</a><% } %>
      <span class="pg-info"><%= pg.total %> beneficiary(ies)</span>
    <% } else { %>
      <span class="pg-info"><%= pg.total %> beneficiary(ies)</span>
    <% } %>
  </div>
</div>