<% var pageTitle = cfg.title; var title = pageTitle; %>
<% var listCols = cfg.listCols; %>

<div class="page-head">
  <div>
    <h1 class="page-title"><%= allowedSector ? allowedSector.name : '' %> — <%= cfg.title %></h1>
    <p class="page-sub">Records in your assigned sector. Case files are created and assigned by the administrator.</p>
  </div>
</div>

<div class="card">
  <div class="toolbar">
    <form method="GET" action="/officer/cases">
      <input type="text" name="search" value="<%= search %>" class="form-control compact" style="min-width:220px" placeholder="Search reference or name...">
      <select name="status" class="form-control compact">
        <option value="all">All statuses</option>
        <% cfg.statuses.forEach(function(st) { %>
          <option value="<%= st %>" <%= status === st ? 'selected' : '' %>><%= st %></option>
        <% }) %>
      </select>
      <button type="submit" class="btn btn-outline">Filter</button>
    </form>
  </div>

  <div class="card-body flush">
    <% if (rows.length === 0) { %>
      <div class="empty-state"><p>No cases found.</p></div>
    <% } else { %>
      <div class="table-wrap">
        <table class="table">
          <thead>
            <tr>
              <th>Beneficiary</th>
              <% listCols.forEach(function(col) { %>
                <% var label = cfg.fields.filter(function(f){ return f.col === col; })[0]; %>
                <th><%= label ? label.label : col %></th>
              <% }) %>
              <th></th>
            </tr>
          </thead>
          <tbody>
            <% rows.forEach(function(r) { %>
              <tr>
                <td class="row-primary"><%= h.fullName(r) %></td>
                <% listCols.forEach(function(col) { %>
                  <% if (col === cfg.statusColumn) { %>
                    <td><span class="badge <%= h.badgeClass(r[col]) %>"><%= r[col] || '—' %></span></td>
                  <% } else if (col === cfg.numberColumn) { %>
                    <td><a href="/officer/cases/<%= r.id %>"><%= r[col] || '—' %></a></td>
                  <% } else if (col === 'date_opened' || col === 'valid_until' || col === 'registration_date') { %>
                    <td class="row-muted"><%= h.formatDisplayDate(r[col]) %></td>
                  <% } else { %>
                    <td><%= r[col] || '—' %></td>
                  <% } %>
                <% }) %>
                <td><a class="btn btn-ghost btn-sm" href="/officer/cases/<%= r.id %>">Open</a></td>
              </tr>
            <% }) %>
          </tbody>
        </table>
      </div>
    <% } %>
  </div>

  <div class="pagination">
    <% if (pg.totalPages > 1) { %>
      <% if (pg.hasPrev) { %><a class="page-link" href="/officer/cases?page=<%= pg.page - 1 %>">&laquo;</a><% } %>
      <% for (var p = Math.max(1, pg.page - 2); p <= Math.min(pg.totalPages, pg.page + 2); p++) { %>
        <a class="page-link <%= p === pg.page ? 'current' : '' %>" href="/officer/cases?page=<%= p %>"><%= p %></a>
      <% } %>
      <% if (pg.hasNext) { %><a class="page-link" href="/officer/cases?page=<%= pg.page + 1 %>">&raquo;</a><% } %>
      <span class="pg-info"><%= pg.total %> case(s)</span>
    <% } else { %>
      <span class="pg-info"><%= pg.total %> case(s)</span>
    <% } %>
  </div>
</div>