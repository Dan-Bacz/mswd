<% var isEdit = typeof b !== 'undefined' && b; var pageTitle = isEdit ? 'Edit Beneficiary' : 'Register Beneficiary'; var title = pageTitle; %>

<div class="page-head">
  <div>
    <h1 class="page-title"><%= pageTitle %></h1>
    <p class="page-sub">Beneficiaries are automatically recorded under your assigned sector (<%= allowedSector ? allowedSector.name : '—' %>).</p>
  </div>
  <a class="btn btn-outline" href="/officer/beneficiaries">&laquo; Back</a>
</div>

<div class="card">
  <div class="card-body">
    <form method="POST" action="<%= isEdit ? '/officer/beneficiaries/' + b.id : '/officer/beneficiaries' %>">
      <input type="hidden" name="_csrf" value="<%= csrfToken %>">
      <div class="form-grid">
        <div class="form-group">
          <label for="first_name">First Name <span class="required-star">*</span></label>
          <input type="text" id="first_name" name="first_name" class="form-control" required value="<%= isEdit ? b.first_name : '' %>">
        </div>
        <div class="form-group">
          <label for="middle_name">Middle Name</label>
          <input type="text" id="middle_name" name="middle_name" class="form-control" value="<%= isEdit && b.middle_name ? b.middle_name : '' %>">
        </div>
        <div class="form-group">
          <label for="last_name">Last Name <span class="required-star">*</span></label>
          <input type="text" id="last_name" name="last_name" class="form-control" required value="<%= isEdit ? b.last_name : '' %>">
        </div>
        <div class="form-group">
          <label for="suffix">Suffix</label>
          <input type="text" id="suffix" name="suffix" class="form-control" value="<%= isEdit && b.suffix ? b.suffix : '' %>">
        </div>
        <div class="form-group">
          <label for="date_of_birth">Date of Birth</label>
          <input type="date" id="date_of_birth" name="date_of_birth" class="form-control" value="<%= h.formatDate(isEdit ? b.date_of_birth : '') %>">
        </div>
        <div class="form-group">
          <label for="sex">Sex</label>
          <select id="sex" name="sex" class="form-control">
            <option value="">-- Select --</option>
            <% ['Male', 'Female', 'Other'].forEach(function(o) { %>
              <option value="<%= o %>" <%= isEdit && b.sex === o ? 'selected' : '' %>><%= o %></option>
            <% }) %>
          </select>
        </div>
        <div class="form-group">
          <label for="civil_status">Civil Status</label>
          <select id="civil_status" name="civil_status" class="form-control">
            <option value="">-- Select --</option>
            <% ['Single', 'Married', 'Widowed', 'Separated', 'Divorced', 'Common-Law'].forEach(function(o) { %>
              <option value="<%= o %>" <%= isEdit && b.civil_status === o ? 'selected' : '' %>><%= o %></option>
            <% }) %>
          </select>
        </div>
        <div class="form-group">
          <label for="barangay">Barangay</label>
          <input type="text" id="barangay" name="barangay" class="form-control" value="<%= isEdit && b.barangay ? b.barangay : '' %>">
        </div>
        <div class="form-group full">
          <label for="address">Address</label>
          <textarea id="address" name="address" class="form-control" rows="2"><%= isEdit && b.address ? b.address : '' %></textarea>
        </div>
        <div class="form-group">
          <label for="contact_number">Contact Number</label>
          <input type="text" id="contact_number" name="contact_number" class="form-control" value="<%= isEdit && b.contact_number ? b.contact_number : '' %>">
        </div>
        <div class="form-group">
          <label for="email">Email</label>
          <input type="email" id="email" name="email" class="form-control" value="<%= isEdit && b.email ? b.email : '' %>">
        </div>
      </div>
      <div class="form-actions">
        <button type="submit" class="btn btn-primary"><%= isEdit ? 'Save Changes' : 'Register Beneficiary' %></button>
        <a class="btn btn-outline" href="/officer/beneficiaries">Cancel</a>
      </div>
    </form>
  </div>
</div>