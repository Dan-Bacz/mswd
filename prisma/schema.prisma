generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

enum RoleName {
  ADMIN
  OFFICER
}

enum UserStatus {
  ACTIVE
  INACTIVE
  PENDING_APPROVAL
}

enum Sex {
  MALE
  FEMALE
  OTHER
}

enum CivilStatus {
  SINGLE
  MARRIED
  WIDOWED
  SEPARATED
  DIVORCED
  OTHERS
}

enum BeneficiaryStatus {
  ACTIVE
  INACTIVE
  ARCHIVED
}

enum AssistanceType {
  FINANCIAL_ASSISTANCE
  MEDICAL_ASSISTANCE
  FOOD_ASSISTANCE
  BURIAL_FUNERAL_ASSISTANCE
  TRANSPORTATION_ASSISTANCE
  EDUCATIONAL_ASSISTANCE
  PSYCHOSOCIAL_SUPPORT
  REFERRAL_LINKAGE
  OTHER
}

enum AssistanceOutcome {
  PROVIDED
  REFERRED
  FOLLOW_UP
  NOT_PROVIDED
}

enum BeneficiaryFileType {
  VALID_ID_FRONT
  VALID_ID_BACK
  PROFILE_IMAGE
}

model Role {
  id    String   @id @default(uuid())
  name  RoleName @unique
  users User[]
}

model User {
  id                    String                  @id @default(uuid())
  name                  String
  firstName             String?
  middleName            String?
  lastName              String?
  position              String?
