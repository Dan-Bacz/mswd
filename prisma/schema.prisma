model UserCategory {
  id         String   @id @default(uuid())
  userId     String
  categoryId String
  createdAt  DateTime @default(now())
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  category   Category @relation(fields: [categoryId], references: [id], onDelete: Cascade)

  @@unique([userId, categoryId])
}

model Category {
  id             String         @id @default(uuid())
  name           String         @unique
  description    String?
  createdAt      DateTime       @default(now())
  updatedAt      DateTime       @updatedAt
  userCategories UserCategory[]
  beneficiaries  Beneficiary[]
  assignments    Assignment[]
}

model Household {
  id              String        @id @default(uuid())
  headName        String
  numberOfMembers Int           @default(1)
  address         String
  barangay        String?
  municipality    String?
  province        String?
  estimatedIncome Decimal?      @db.Decimal(12, 2)
  incomeSource    String?
  housingInfo     String?
  remarks         String?
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt
  createdById     String?
  createdBy       User?         @relation(fields: [createdById], references: [id])
  beneficiaries   Beneficiary[]
}

model Beneficiary {
  id                String                  @id @default(uuid())
  beneficiaryNumber String                  @unique
  identityKey       String?                 @unique
  firstName         String
  middleName        String?
  lastName          String
  suffix            String?
  sex               Sex
  dateOfBirth       DateTime?
  age               Int?
  civilStatus       CivilStatus?
  contactNumber     String?
  email             String?
  address           String
  barangay          String?
  municipality      String?
  province          String?
  categoryId        String
  subcategory       String?
  householdId       String?
  assignedOfficerId String?
  registrationDate  DateTime                @default(now())
  status            BeneficiaryStatus       @default(ACTIVE)
  remarks           String?
  category          Category                @relation(fields: [categoryId], references: [id])
  household         Household?              @relation(fields: [householdId], references: [id])
  assignedOfficer   User?                   @relation("OfficerBeneficiaries", fields: [assignedOfficerId], references: [id])
  documents         Document[]
  assignments       Assignment[]
  assistanceRecords BeneficiaryAssistance[]
  createdAt         DateTime                @default(now())
  updatedAt         DateTime                @updatedAt
}

model BeneficiaryAssistance {
  id                   String            @id @default(uuid())
  referenceNumber      String            @unique
  beneficiaryId        String
  type                 AssistanceType
  otherType            String?
  visitDate            DateTime          @db.Date
  purpose              String
  requestedDescription String
  outcome              AssistanceOutcome @default(PROVIDED)
  providedDescription  String?
  medicineCount        Int?
  providerName         String?
  financialAmount      Decimal?          @db.Decimal(12, 2)
  financialType        String?
  transactionDetails   String?
  providedAt           DateTime?         @db.Date
  notProvidedReason    String?
  referralDetails      String?
  followUpReason       String?
  followUpNotes        String?
  internalRemarks      String?
  financialAmount      Decimal?          @db.Decimal(12, 2)
  medicineQuantity     Int?
  doctorName           String?
  providedById         String
  createdAt            DateTime          @default(now())
  updatedAt            DateTime          @updatedAt
  beneficiary          Beneficiary       @relation(fields: [beneficiaryId], references: [id], onDelete: Cascade)
  providedBy           User              @relation("AssistanceProvider", fields: [providedById], references: [id], onDelete: Restrict)

  @@index([beneficiaryId, visitDate])
  @@index([providedById, visitDate])
  @@index([outcome, visitDate])
}

model Document {
  id            String               @id @default(uuid())
  beneficiaryId String?
  uploaderId    String
  fileType      BeneficiaryFileType?
  fileName      String
  originalName  String
  mimeType      String
  size          Int
  content       Bytes?               @db.ByteA
  storageUrl    String
  uploadedAt    DateTime             @default(now())
  beneficiary   Beneficiary?         @relation(fields: [beneficiaryId], references: [id], onDelete: Cascade)
  uploader      User                 @relation("UploaderDocuments", fields: [uploaderId], references: [id])
}

model Assignment {
  id            String       @id @default(uuid())
  officerId     String
  categoryId    String?
  beneficiaryId String?
  assignedById  String
  createdAt     DateTime     @default(now())
  officer       User         @relation("AssignedOfficer", fields: [officerId], references: [id])
  assignedBy    User         @relation("AssignedBy", fields: [assignedById], references: [id])
  category      Category?    @relation(fields: [categoryId], references: [id])
  beneficiary   Beneficiary? @relation(fields: [beneficiaryId], references: [id])
}

model Notification {
  id        String   @id @default(uuid())
  userId    String
  title     String
  message   String
  type      String
  link      String?
  dedupeKey String?  @unique
  isRead    Boolean  @default(false)
  createdAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, isRead])
}

model StaffIdDocument {
  id           String   @id @default(uuid())
  userId       String   @unique
  fileName     String
  originalName String
  mimeType     String
  size         Int
  content      Bytes    @db.ByteA
  uploadedAt   DateTime @default(now())
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model AuditLog {
  id          String   @id @default(uuid())
  userId      String?
  action      String
  module      String
  recordId    String?
  description String
  ipAddress   String?
  createdAt   DateTime @default(now())
  user        User?    @relation(fields: [userId], references: [id])
}

model SystemSetting {
  id          String   @id @default(uuid())
  key         String   @unique
  value       String
  description String?
  updatedAt   DateTime @updatedAt
}
