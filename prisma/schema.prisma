generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

enum RoleName {
  ADMIN
  OFFICER
}

enum UserStatus {
  ACTIVE
  INACTIVE
  PENDING_APPROVAL
}

enum Sex {
  MALE
  FEMALE
  OTHER
}

enum CivilStatus {
  SINGLE
  MARRIED
  WIDOWED
  SEPARATED
  DIVORCED
  OTHERS
}

enum BeneficiaryStatus {
  ACTIVE
  INACTIVE
  ARCHIVED
}

enum AssistanceType {
  FINANCIAL_ASSISTANCE
  MEDICAL_ASSISTANCE
  FOOD_ASSISTANCE
  BURIAL_FUNERAL_ASSISTANCE
  TRANSPORTATION_ASSISTANCE
  EDUCATIONAL_ASSISTANCE
  PSYCHOSOCIAL_SUPPORT
  REFERRAL_LINKAGE
  OTHER
}

model Role {
  id    String   @id @default(uuid())
  name  RoleName @unique
  users User[]
}

model User {
  id                    String                  @id @default(uuid())
  name                  String
  email                 String                  @unique
  passwordHash          String
  roleId                String
  status                UserStatus              @default(ACTIVE)
  createdAt             DateTime                @default(now())
  updatedAt             DateTime                @updatedAt
  role                  Role                    @relation(fields: [roleId], references: [id])
  userCategories        UserCategory[]
  households            Household[]
  assignedBeneficiaries Beneficiary[]           @relation("OfficerBeneficiaries")
  providedAssistance    BeneficiaryAssistance[] @relation("AssistanceProvider")
  documents             Document[]              @relation("UploaderDocuments")
  assignments           Assignment[]            @relation("AssignedOfficer")
  assignedBy            Assignment[]            @relation("AssignedBy")
  notifications         Notification[]
  auditLogs             AuditLog[]
}

model UserCategory {
  id         String   @id @default(uuid())
  userId     String
  categoryId String
  createdAt  DateTime @default(now())
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  category   Category @relation(fields: [categoryId], references: [id], onDelete: Cascade)

  @@unique([userId, categoryId])
}

model Category {
  id             String         @id @default(uuid())
  name           String         @unique
  description    String?
  createdAt      DateTime       @default(now())
  updatedAt      DateTime       @updatedAt
  userCategories UserCategory[]
  beneficiaries  Beneficiary[]
  assignments    Assignment[]
}

model Household {
  id              String        @id @default(uuid())
  headName        String
  numberOfMembers Int           @default(1)
  address         String
  barangay        String?
  municipality    String?
  province        String?
  estimatedIncome Decimal?      @db.Decimal(12, 2)
  incomeSource    String?
  housingInfo     String?
  remarks         String?
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt
  createdById     String?
  createdBy       User?         @relation(fields: [createdById], references: [id])
  beneficiaries   Beneficiary[]
}

model Beneficiary {
  id                String                  @id @default(uuid())
  beneficiaryNumber String                  @unique
  firstName         String
  middleName        String?
  lastName          String
  suffix            String?
  sex               Sex
  dateOfBirth       DateTime?
  age               Int?
  civilStatus       CivilStatus?
  contactNumber     String?
  email             String?
  address           String
  barangay          String?
  municipality      String?
  province          String?
  categoryId        String
  subcategory       String?
  householdId       String?
  assignedOfficerId String?
  registrationDate  DateTime                @default(now())
  status            BeneficiaryStatus       @default(ACTIVE)
  remarks           String?
  category          Category                @relation(fields: [categoryId], references: [id])
  household         Household?              @relation(fields: [householdId], references: [id])
  assignedOfficer   User?                   @relation("OfficerBeneficiaries", fields: [assignedOfficerId], references: [id])
  documents         Document[]
  assignments       Assignment[]
  assistanceRecords BeneficiaryAssistance[]
  createdAt         DateTime                @default(now())
  updatedAt         DateTime                @updatedAt
}

model BeneficiaryAssistance {
  id            String         @id @default(uuid())
  beneficiaryId String
  type          AssistanceType
  otherType     String?
  providedAt    DateTime       @db.Date
  notes         String?
  providedById  String
  createdAt     DateTime       @default(now())
  beneficiary   Beneficiary    @relation(fields: [beneficiaryId], references: [id], onDelete: Cascade)
  providedBy    User           @relation("AssistanceProvider", fields: [providedById], references: [id], onDelete: Restrict)

  @@index([beneficiaryId, providedAt])
  @@index([providedById, providedAt])
}

model Document {
  id            String       @id @default(uuid())
  beneficiaryId String?
  uploaderId    String
  fileName      String
  originalName  String
  mimeType      String
  size          Int
  storageUrl    String
  uploadedAt    DateTime     @default(now())
  beneficiary   Beneficiary? @relation(fields: [beneficiaryId], references: [id], onDelete: Cascade)
  uploader      User         @relation("UploaderDocuments", fields: [uploaderId], references: [id])
}

model Assignment {
  id            String       @id @default(uuid())
  officerId     String
  categoryId    String?
  beneficiaryId String?
  assignedById  String
  createdAt     DateTime     @default(now())
  officer       User         @relation("AssignedOfficer", fields: [officerId], references: [id])
  assignedBy    User         @relation("AssignedBy", fields: [assignedById], references: [id])
  category      Category?    @relation(fields: [categoryId], references: [id])
  beneficiary   Beneficiary? @relation(fields: [beneficiaryId], references: [id])
}

model Notification {
  id        String   @id @default(uuid())
  userId    String
  title     String
  message   String
  type      String
  isRead    Boolean  @default(false)
  createdAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model AuditLog {
  id          String   @id @default(uuid())
  userId      String?
  action      String
  module      String
  recordId    String?
  description String
  ipAddress   String?
  createdAt   DateTime @default(now())
  user        User?    @relation(fields: [userId], references: [id])
}

model SystemSetting {
  id          String   @id @default(uuid())
  key         String   @unique
  value       String
  description String?
  updatedAt   DateTime @updatedAt
}
