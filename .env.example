# MSWD Management System - Environment Variables
# Copy this file to `.env` and fill in the REAL values. NEVER commit .env.

# -- Database --
DB_HOST=localhost
DB_PORT=3306
DB_NAME=mswd_mahayag
DB_USER=your_database_user
DB_PASSWORD=your_database_password

# -- App --
# Strong random secret for sessions. Generate with: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
SESSION_SECRET=change-this-to-a-long-random-secret-string
NODE_ENV=production
PORT=3000

# -- Security --
# Increase only if an upstream proxy is present.
TRUST_PROXY=1